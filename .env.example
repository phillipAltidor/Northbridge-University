DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=northbridge_university
DB_USER=root
DB_PASS=
APP_ENV=local

# Fictional accounts only. Blank sends to the registered account email.
# Set APP_ENV=local or demo to allow this override; never use with real users.
MAIL_DEMO_RECIPIENT=

# Sender credentials belong only in the private .env file.
MAIL_HOST=smtp.mail.yahoo.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Northbridge University"
